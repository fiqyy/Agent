{
    "version": 2,
    "builds": [
        {
            "src": "backend/vercel_entry.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/vercel_entry.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/$1"
        }
    ],
    "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings"
    }
}